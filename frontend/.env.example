# Firebase Web App configuration (client-safe values)
NEXT_PUBLIC_FIREBASE_API_KEY=PASTE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=PASTE_PROJECT_ID.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=PASTE_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=PASTE_PROJECT_ID.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=PASTE_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=PASTE_APP_ID
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=PASTE_MEASUREMENT_ID

# Gemma 4 via Gemini API, admin-only server-side analysis. Never expose in browser or use NEXT_PUBLIC_.
GEMINI_API_KEY=PASTE_GEMINI_API_KEY
GEMINI_MODEL=gemma-4-26b-a4b-it
